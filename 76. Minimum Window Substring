class Solution {
    public String minWindow(String s, String t) {
        int[] mp = new int[200];

        for (int i = 0; i < t.length(); i++) {
            mp[t.charAt(i)]++;
        }

        int startIdx = -1;
        int count = t.length();
        int n = s.length();
        int l = 0, r = 0;
        int minLen = Integer.MAX_VALUE;

        while (r < n) {
            if (mp[s.charAt(r++)]-- > 0) {
                count--;
            }

            while (count == 0) {
                if (r - l < minLen) {
                    startIdx = l;
                    minLen = r - l;
                }

                if (mp[s.charAt(l++)]++ == 0) {
                    count++;
                }
            }
        }

        return minLen == Integer.MAX_VALUE ? "" : s.substring(startIdx, startIdx + minLen);
    }
}
