class Solution {
    public int[] twoSum(int[] nums, int target) {
        
        int s = 0, e = nums.length - 1;

        while (s <= e) {
            int total = nums[s] + nums[e];

            if (total == target) {
                return new int[]{s + 1, e + 1};
            } else if (total > target) {
                e--;
            } else {
                s++;
            }
        }

        return new int[]{-1, -1};
    }
}
