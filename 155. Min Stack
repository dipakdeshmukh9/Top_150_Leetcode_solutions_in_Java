class MinStack {

    private Stack<Long> st;
    private long mini;

    public MinStack() {
        st = new Stack<>();
        mini = Long.MAX_VALUE;
    }

    public void push(int val) {
        if (st.isEmpty()) {
            st.push((long) val);
            mini = val;
        } else if (val > mini) {
            st.push((long) val);
        } else {
            st.push(2L * val - mini);
            mini = val;
        }
    }

    public void pop() {
        if (st.isEmpty()) return;

        if (st.peek() > mini) {
            st.pop();
        } else {
            mini = 2 * mini - st.peek();
            st.pop();
        }
    }

    public int top() {
        if (st.isEmpty()) return -1;

        if (st.peek() > mini) {
            return st.peek().intValue();
        }
        return (int) mini;
    }

    public int getMin() {
        if (st.isEmpty()) return -1;
        return (int) mini;
    }
}

