/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) {
 *         this.val = val;
 *         this.next = next;
 *     }
 * }
 */
class Solution {
    public ListNode partition(ListNode head, int x) {
        List<Integer> lessVal = new ArrayList<>();
        List<Integer> moreVal = new ArrayList<>();

        ListNode temp = head;

        while (temp != null) {
            if (temp.val < x) {
                lessVal.add(temp.val);
            } else {
                moreVal.add(temp.val);
            }
            temp = temp.next;
        }

        temp = head;

        for (int val : lessVal) {
            temp.val = val;
            temp = temp.next;
        }

        for (int val : moreVal) {
            temp.val = val;
            temp = temp.next;
        }

        return head;
    }
}
