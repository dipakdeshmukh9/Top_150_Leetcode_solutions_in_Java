class Solution {
    private double dfs(String a, String b,
                       Map<String, Map<String, Double>> graph,
                       Set<String> visited) {

        if (!graph.containsKey(a)) {
            return 0.0;
        }

        if (graph.get(a).containsKey(b)) {
            return graph.get(a).get(b);
        }

        for (Map.Entry<String, Double> node : graph.get(a).entrySet()) {
            if (!visited.contains(node.getKey())) {
                visited.add(node.getKey());

                double val = dfs(node.getKey(), b, graph, visited);

                if (val != 0.0) {
                    graph.get(a).put(b, node.getValue() * val);
                    return graph.get(a).get(b);
                }
            }
        }

        return 0.0;
    }

    public double[] calcEquation(List<List<String>> equations, double[] values,
                                 List<List<String>> queries) {

        Map<String, Map<String, Double>> graph = new HashMap<>();

        for (int i = 0; i < equations.size(); i++) {
            String u = equations.get(i).get(0);
            String v = equations.get(i).get(1);

            graph.putIfAbsent(u, new HashMap<>());
            graph.putIfAbsent(v, new HashMap<>());

            graph.get(u).put(v, values[i]);
            graph.get(v).put(u, 1.0 / values[i]);
        }

        double[] ans = new double[queries.size()];

        for (int i = 0; i < queries.size(); i++) {
            Set<String> visited = new HashSet<>();

            double val = dfs(queries.get(i).get(0), queries.get(i).get(1), graph, visited);

            if (val == 0.0) {
                ans[i] = -1.0;
            } else {
                ans[i] = val;
            }
        }

        return ans;
    }
}
