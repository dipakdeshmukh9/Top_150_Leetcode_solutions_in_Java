class Solution {
    public boolean wordPattern(String pattern, String s) {
        
        HashMap<Character, Integer> p2i = new HashMap<>();
        HashMap<String, Integer> w2i = new HashMap<>();

        String[] words = s.split(" ");

        if (words.length != pattern.length()) {
            return false;
        }

        for (int i = 0; i < pattern.length(); i++) {
            if (!Objects.equals(p2i.get(pattern.charAt(i)), w2i.get(words[i]))) {
                return false;
            }

            p2i.put(pattern.charAt(i), i + 1);
            w2i.put(words[i], i + 1);
        }

        return true;
    }
}
