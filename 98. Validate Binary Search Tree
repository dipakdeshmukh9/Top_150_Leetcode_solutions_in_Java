/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private boolean isValidTree(TreeNode root, long left, long right) {
        if (root == null) {
            return true;
        }

        if (root.val > left && root.val < right) {
            return isValidTree(root.left, left, root.val)
                    && isValidTree(root.right, root.val, right);
        }

        return false;
    }

    public boolean isValidBST(TreeNode root) {
        return isValidTree(root, Long.MIN_VALUE, Long.MAX_VALUE);
    }
}
