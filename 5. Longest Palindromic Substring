class Solution {
    private String expandFromCenter(int left, int right, String s, String ans) {
        int n = s.length();

        while (left >= 0 && right < n && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }

        if (ans.length() < right - left - 1) {
            return s.substring(left + 1, right);
        }

        return ans;
    }

    public String longestPalindrome(String s) {
        int n = s.length();

        if (n == 0) {
            return "";
        }

        String ans = s.substring(0, 1);

        for (int i = 0; i < n; i++) {
            ans = expandFromCenter(i - 1, i + 1, s, ans); // Odd length
            ans = expandFromCenter(i, i + 1, s, ans);     // Even length
        }

        return ans;
    }
}
