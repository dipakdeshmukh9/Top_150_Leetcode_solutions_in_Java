/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    HashMap<Integer, Integer> map = new HashMap<>();

    public TreeNode buildTreeRecur(int[] postorder, int[] inorder, int left, int right, int[] postIndex) {
        if (left > right) {
            return null;
        }

        int nodeVal = postorder[postIndex[0]];
        postIndex[0]--;

        TreeNode newNode = new TreeNode(nodeVal);

        int inOrderIndex = map.get(nodeVal);

        newNode.right = buildTreeRecur(postorder, inorder, inOrderIndex + 1, right, postIndex);
        newNode.left = buildTreeRecur(postorder, inorder, left, inOrderIndex - 1, postIndex);

        return newNode;
    }

    public TreeNode buildTree(int[] inorder, int[] postorder) {
        int n = inorder.length;
        int[] postIndex = {n - 1};

        for (int i = 0; i < n; i++) {
            map.put(inorder[i], i);
        }

        return buildTreeRecur(postorder, inorder, 0, n - 1, postIndex);
    }
}
