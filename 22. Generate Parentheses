class Solution {

    void helper(List<String> ans, int n, int open, int close, StringBuilder s) {
        if (open == n && close == n) {
            ans.add(s.toString());
            return;
        }

        if (open < n) {
            s.append('(');
            helper(ans, n, open + 1, close, s);
            s.deleteCharAt(s.length() - 1);
        }

        if (close < open) {
            s.append(')');
            helper(ans, n, open, close + 1, s);
            s.deleteCharAt(s.length() - 1);
        }
    }

    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        helper(ans, n, 0, 0, new StringBuilder());
        return ans;
    }
}
