/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {

    HashMap<Integer, Integer> map = new HashMap<>();

    public TreeNode buildTreeRecur(int[] preorder, int[] inorder, int left, int right, int[] preIndex) {
        if (left > right) {
            return null;
        }

        int nodeVal = preorder[preIndex[0]];
        preIndex[0]++;

        TreeNode newNode = new TreeNode(nodeVal);

        int inOrderIndex = map.get(nodeVal);

        newNode.left = buildTreeRecur(preorder, inorder, left, inOrderIndex - 1, preIndex);
        newNode.right = buildTreeRecur(preorder, inorder, inOrderIndex + 1, right, preIndex);

        return newNode;
    }

    public TreeNode buildTree(int[] preorder, int[] inorder) {
        int inOrderSize = inorder.length;
        int[] preIndex = new int[1];

        for (int i = 0; i < inOrderSize; i++) {
            map.put(inorder[i], i);
        }

        return buildTreeRecur(preorder, inorder, 0, inOrderSize - 1, preIndex);
    }
}
