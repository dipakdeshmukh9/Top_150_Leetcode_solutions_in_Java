class Solution {

    void solve(String digits, StringBuilder output, int i,
               List<String> ans, String[] mapping) {

        if (i >= digits.length()) {
            ans.add(output.toString());
            return;
        }

        int number = digits.charAt(i) - '0';
        String val = mapping[number];

        for (int j = 0; j < val.length(); j++) {
            output.append(val.charAt(j));
            solve(digits, output, i + 1, ans, mapping);
            output.deleteCharAt(output.length() - 1);
        }
    }

    public List<String> letterCombinations(String digits) {
        List<String> ans = new ArrayList<>();

        if (digits.length() == 0) {
            return ans;
        }

        StringBuilder output = new StringBuilder();

        String[] mapping = {
            "", "", "abc", "def", "ghi",
            "jkl", "mno", "pqrs", "tuv", "wxyz"
        };

        solve(digits, output, 0, ans, mapping);

        return ans;
    }
}
