class Solution {
    private int solve(int ind, int[] dp, int[] nums) {
        if (ind == 0) {
            return nums[0];
        }
        if (ind < 0) {
            return 0;
        }

        if (dp[ind] != -1) {
            return dp[ind];
        }

        int pick = nums[ind] + solve(ind - 2, dp, nums);
        int notPick = solve(ind - 1, dp, nums);

        dp[ind] = Math.max(pick, notPick);
        return dp[ind];
    }

    public int rob(int[] nums) {
        int n = nums.length;
        int[] dp = new int[n];
        java.util.Arrays.fill(dp, -1);
        return solve(n - 1, dp, nums);
    }
}
