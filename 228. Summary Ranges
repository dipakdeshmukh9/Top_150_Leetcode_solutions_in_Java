class Solution {
    public List<String> summaryRanges(int[] nums) {
        
        List<String> res = new ArrayList<>();
        int n = nums.length;

        for (int i = 0; i < n;) {
            int start = i;
            int end = i;

            while (end + 1 < n && nums[end + 1] == nums[end] + 1) {
                end++;
            }

            if (end > start) {
                res.add(nums[start] + "->" + nums[end]);
            } else {
                res.add(String.valueOf(nums[start]));
            }

            i = end + 1;
        }

        return res;
    }
}
