class Solution {
    public int lengthOfLastWord(String s) {
        
        int e = s.length() - 1;

        while (e >= 0 && s.charAt(e) == ' ') {
            e--;
        }

        int start = e;

        while (start >= 0 && s.charAt(start) != ' ') {
            start--;
        }

        return e - start;
    }
}
